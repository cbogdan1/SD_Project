@startuml deployment
' UML deployment diagram of the Energy Management System.
' Render to PNG: docker run --rm -v "$PWD/docs":/data plantuml/plantuml:1.2024.7 -tpng /data/deployment.puml
title Energy Management System - UML Deployment Diagram
left to right direction

node "Client PC" <<device>> {
  node "Web Browser" <<executionEnvironment>> as browser {
    artifact "Angular SPA" as spa
  }
}

node "Docker Host" <<device>> {
  frame "app-network (bridge)" {

    node "reverse-proxy\n(traefik:v3.6)\nhost :80, dashboard :8082" <<executionEnvironment>> as traefik

    node "frontend\n(nginx:alpine)" <<executionEnvironment>> as frontend {
      artifact "Angular build\n(dist/frontend/browser)" as bundle
    }

    node "auth-service\n(eclipse-temurin:17-jre)" <<executionEnvironment>> as auth {
      artifact "app.jar\n(auth_management)" as authJar
    }

    node "user-service\n(eclipse-temurin:17-jre)" <<executionEnvironment>> as users {
      artifact "app.jar\n(user_management)" as userJar
    }

    node "device-service\n(eclipse-temurin:17-jre)" <<executionEnvironment>> as devices {
      artifact "app.jar\n(device_management)" as deviceJar
    }

    node "auth-db / auth-postgres\n(postgres:15-alpine)" <<executionEnvironment>> as authDbNode {
      artifact "auth_sd schema\n(credential)" <<schema>> as authDb
    }

    node "user-db / user-postgres\n(postgres:15-alpine)" <<executionEnvironment>> as userDbNode {
      artifact "user_sd schema\n(person)" <<schema>> as userDb
    }

    node "device-db / device-postgres\n(postgres:15-alpine)" <<executionEnvironment>> as deviceDbNode {
      artifact "device_sd schema\n(device, app_user)" <<schema>> as deviceDb
    }
  }
}

browser --> traefik : HTTP :80

traefik --> frontend : HTTP :80\n/ (everything else)
traefik --> auth : HTTP :8083\n/auth/login, /auth/register\n+ ForwardAuth /validate
traefik --> users : HTTP :8080\n/users/**
traefik --> devices : HTTP :8081\n/devices/**

auth --> users : HTTP :8080\nPOST /person (register)
users --> auth : HTTP :8083\nDELETE /credentials/user/{id}
users --> devices : HTTP :8081\nPOST, DELETE /device/user/{id}

auth --> authDbNode : JDBC :5432
users --> userDbNode : JDBC :5432
devices --> deviceDbNode : JDBC :5432

note bottom of users
  user-service and device-service have no
  container_name / ports, so they can be scaled:
  docker compose up --scale user-service=N
  Traefik load-balances the replicas.
end note

@enduml
